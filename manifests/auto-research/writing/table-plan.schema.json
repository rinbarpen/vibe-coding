{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "statistics": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "comparison_group": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "reproduced",
        "checkpoint_evaluated"
      ]
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer"
      },
      "uniqueItems": true
    },
    "layout": {
      "enum": [
        "single_column",
        "double_column"
      ]
    },
    "display": {
      "enum": [
        "mean",
        "mean_sd"
      ]
    },
    "highlight": {
      "enum": [
        "none",
        "best"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "label",
          "experiment_id",
          "parameters"
        ]
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "source"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "maximize",
              "minimize"
            ]
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "required": [
          "id",
          "label",
          "source",
          "direction",
          "scale",
          "precision"
        ]
      }
    }
  },
  "required": [
    "version",
    "id",
    "caption",
    "statistics",
    "protocol",
    "comparison_group",
    "source_kind",
    "seeds",
    "layout",
    "display",
    "highlight",
    "rows",
    "datasets",
    "metrics"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
